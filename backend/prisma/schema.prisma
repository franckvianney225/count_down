generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TimerSettings {
  id                  Int       @id @default(autoincrement())
  duration            Int       @default(1800)
  isActive            Boolean   @default(false)
  startedAt           DateTime?
  remainingSeconds    Int       @default(1800)
  lastUpdated         DateTime  @updatedAt
  backgroundImageUrl  String?
  panelPosterUrl      String?
  panelPosterVisible  Boolean   @default(false)

  @@map("timer_settings")
}

model EventSession {
  id                Int       @id @default(autoincrement())
  name              String    @default("Session")
  currentPhaseIndex Int       @default(0)
  isActive          Boolean   @default(false)
  startedAt         DateTime?
  pausedRemaining   Int?
  lastUpdated       DateTime  @updatedAt
  phases            Phase[]

  @@map("event_sessions")
}

model Phase {
  id            Int            @id @default(autoincrement())
  name          String
  duration      Int
  order         Int
  sessionId     Int
  session       EventSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  panelistPhases PanelistPhase[]

  @@map("phases")
}

model EventTemplate {
  id        Int             @id @default(autoincrement())
  name      String
  createdAt DateTime        @default(now())
  phases    TemplatePhase[]

  @@map("event_templates")
}

model TemplatePhase {
  id         Int           @id @default(autoincrement())
  name       String
  duration   Int
  order      Int
  templateId Int
  template   EventTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("template_phases")
}

model Panelist {
  id            Int            @id @default(autoincrement())
  name          String
  totalSeconds  Int
  usedSeconds   Int            @default(0)
  isActive      Boolean        @default(false)
  activatedAt   DateTime?
  order         Int            @default(0)
  photoUrl      String?
  fonction      String?
  structure     String?
  panelistPhases PanelistPhase[]

  @@map("panelists")
}

model PanelistPhase {
  panelistId Int
  phaseId    Int
  panelist   Panelist @relation(fields: [panelistId], references: [id], onDelete: Cascade)
  phase      Phase    @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@id([panelistId, phaseId])
  @@map("panelist_phases")
}

model VoteQuestion {
  id          Int            @id @default(autoincrement())
  code        String         @unique
  question    String
  isActive    Boolean        @default(false)
  isClosed    Boolean        @default(false)
  showResults Boolean        @default(false)
  multiChoice Boolean        @default(false)
  closesAt    DateTime?
  createdAt   DateTime       @default(now())
  options     VoteOption[]
  responses   VoteResponse[]

  @@map("vote_questions")
}

model VoteOption {
  id         Int            @id @default(autoincrement())
  label      String
  order      Int            @default(0)
  questionId Int
  question   VoteQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  responses  VoteResponse[]

  @@map("vote_options")
}

model VoteResponse {
  id         Int          @id @default(autoincrement())
  token      String
  questionId Int
  optionId   Int
  createdAt  DateTime     @default(now())
  question   VoteQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  option     VoteOption   @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([token, questionId, optionId])
  @@map("vote_responses")
}

